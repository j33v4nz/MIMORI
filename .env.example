# Required: Supabase project connection. Never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Optional locally; set your public HTTPS origin in production for OAuth and social links.
APP_URL=

# Optional: extra development hostnames, separated by commas; no scheme or port.
# Keep workstation LAN addresses and tunnel hostnames in .env.local.
MIMORI_DEV_ALLOWED_ORIGINS=

# Ingestion budget per API key per fixed 60-second window (counts events, not requests).
# Default 1200; max batch 500; database limiter failures return retryable HTTP 503.
INGEST_EVENTS_PER_MINUTE=1200

# Optional: asynchronous LLM judge. Cloud-provider keys remain server-only.
LLM_JUDGE_PROVIDER=
LLM_JUDGE_MODEL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
# Comma-separated exact HTTPS origins approved by the operator for custom judge tests.
# Custom origins require the caller's own key; deployment keys stay on provider origins.
MIMORI_JUDGE_ALLOWED_ORIGINS=
CRON_SECRET=

# Optional: LLM Judge sampling rate (0.0–1.0). Default 0.1 (10%).
# Deterministic triggers always queue; this controls random sampling of other events.
LLM_JUDGE_SAMPLING_RATE=0.1

# Optional: LLM-judge budget/kill-switch notes. These are enforced from judge_settings, not env vars.
# budget_monthly: maximum LLM-judge jobs per org per calendar month; NULL means unlimited.
# kill_switch: when true, blocked orgs are skipped and their jobs stay pending.
# Optional: retention worker constants. These are code defaults, not env vars.
# DEFAULT_RETENTION_DAYS=30; MIN_RETENTION_DAYS=1; MAX_RETENTION_DAYS=3650.
# BATCH_SIZE=1000; MAX_BATCHES=100. Use POST /api/workers/retention?dryRun=1 to preview pruning.

# Optional: Laya "System 1" classifier (Layer 1.5 between regex rules and LLM judge).
# When enabled, every event that passes regex rules is classified by Laya.
# High-confidence threats are auto-detected; suspicious events are routed to the LLM judge.
LAYA_ENABLED=false
LAYA_BASE_URL=http://localhost:5050
LAYA_API_KEY=
LAYA_TIMEOUT_MS=5000
LAYA_CONFIDENCE_THRESHOLD=0.7
LAYA_AUTO_DETECT_THRESHOLD=0.9

# Optional: real-time threat alerts webhook (Slack incoming webhook, Discord webhook, or custom URL)
# Must be https: and public (no localhost/private IPs); comma/space/semicolon-separated fan-out (max 5).
# Delivery: best-effort, 3s timeout, 3 attempts for network/429/5xx; 30x redirects not followed.
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_URLS=
# Optional: HMAC-SHA256 signing for alert payloads (X-MIMORI-Signature: sha256=<hex>).
# ALERT_WEBHOOK_SECRET=

# Optional: server log level (trace, debug, info, warn, error, fatal). Default: info.
LOG_LEVEL=info

# Optional: used only by the demo and attack-evaluation scripts.
MIMORI_DEV_API_KEY=
MIMORI_API_URL=
MIMORI_AGENT_NAME=

# Open-source sandbox mode: set true to bypass authentication on localhost
# (ignored in production — boot fails if set when NODE_ENV=production)
# DISABLE_AUTH=true
